---
interface Props {

}

const {} = Astro.props;
---
<div class="blog-list">
  <slot />
</div>

<style lang="scss">
  .blog-list {
    --max-inline-size: 1200px;
    --column-min-size: 18.75rem;
    --gap: max(1.875rem, 2.5%);

    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--column-min-size), 100%), 1fr));
    gap: var(--gap);
    max-inline-size: var(--max-inline-size);
    margin-inline: auto;
    @include mq(md) {
      // border-inline: 1px solid var(--c-border-primary);
    }
  }
</style>
